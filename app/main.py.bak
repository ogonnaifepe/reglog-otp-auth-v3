from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from app.routes import (
    auth_router,
    otp_router,
    admin_router,
    admin_customer_router,
)
from app.config import Config
from app.database import db
from app import auth_logger
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


app = FastAPI(
    title="OTP Authentication System",
    description="Authentication API with OTP verification + Admin Backend",
    version="2.0.0",
    debug=Config.DEBUG,
    docs_url="/docs" if Config.ENABLE_DOCS else None,
    redoc_url="/redoc" if Config.ENABLE_DOCS else None,
    openapi_url="/openapi.json" if Config.ENABLE_DOCS else None,
)


app.add_middleware(
    CORSMiddleware,
    allow_origins=Config.CORS_ORIGINS,
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    allow_headers=["Authorization", "Content-Type", "Accept"],
)


@app.middleware("http")
async def security_headers_middleware(request: Request, call_next):
    response = await call_next(request)

    if Config.ENABLE_SECURITY_HEADERS:
        # Universal security headers (safe for every response)
        response.headers["X-Content-Type-Options"] = "nosniff"
        response.headers["X-Frame-Options"] = "DENY"
        response.headers["X-XSS-Protection"] = "1; mode=block"
        response.headers["Strict-Transport-Security"] = "max-age=31536000; includeSubDomains"
        response.headers["Referrer-Policy"] = "no-referrer"
        response.headers["Permissions-Policy"] = "geolocation=(), microphone=(), camera=()"

        # CSP varies by path docs pages need a relaxed policy
        path = request.url.path
        is_docs_page = (
            path.startswith("/docs")
            or path.startswith("/redoc")
            or path.startswith("/openapi.json")
        )

        if is_docs_page:
            # Relaxed CSP for Swagger UI / ReDoc
            # They load JS/CSS from cdn.jsdelivr.net and use inline scripts
            response.headers["Content-Security-Policy"] = (
                "default-src 'self'; "
                "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; "
                "style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; "
                "img-src 'self' data: https://fastapi.tiangolo.com https://cdn.jsdelivr.net; "
                "font-src 'self' https://cdn.jsdelivr.net data:; "
                "connect-src 'self'; "
                "frame-ancestors 'none'"
            )
        else:
            # Strict CSP for all API responses
            response.headers["Content-Security-Policy"] = (
                "default-src 'none'; frame-ancestors 'none'"
            )

    return response

@app.exception_handler(Exception)
async def unhandled_exception_handler(request: Request, exc: Exception):
    ip = request.client.host if request.client else None
    auth_logger.log_event(
        "unhandled_exception",
        ip=ip,
        success=False,
        details={"path": str(request.url.path), "error": str(exc)},
    )
    logger.exception("Unhandled exception")
    return JSONResponse(status_code=500, content={"detail": "Internal server error"})


app.include_router(auth_router)
app.include_router(otp_router)
app.include_router(admin_router)
app.include_router(admin_customer_router)


@app.get("/")
async def root():
    return {
        "message": "OTP Authentication System",
        "version": "2.0.0",
        "status": "running",
    }


@app.get("/health")
async def health_check():
    if not Config.DEBUG:
        try:
            db.connection.cursor().execute("SELECT 1 FROM DUAL")
            return {"status": "ok"}
        except Exception:
            return {"status": "degraded"}

    try:
        cursor = db.connection.cursor()
        cursor.execute("SELECT 1 FROM DUAL")
        cursor.fetchone()
        cursor.close()
        db_status = "healthy"
    except Exception as e:
        logger.error(f"Health check failed: {e}")
        db_status = "unhealthy"
    return {
        "status": "healthy" if db_status == "healthy" else "degraded",
        "database": db_status,
    }


@app.on_event("shutdown")
def shutdown_event():
    db.close()
    logger.info("Application shutdown complete")